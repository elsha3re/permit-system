@{
    Layout = null;
    var error = ViewBag.Error as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تسجيل الدخول — نظام تصاريح الدخول</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;600;700;900&family=Tajawal:wght@700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="login-wrap" id="screenLogin">
  <div class="login-card">
    <aside class="login-art">
      <div class="login-art-glow"></div>
      <div class="login-art-top"><span class="login-art-chip">🛡️ منصة الوصول الآمن</span></div>
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="login-svg">
        <defs>
          <linearGradient id="lgSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1e7a4f" stop-opacity=".55"/><stop offset="1" stop-color="#0d2518" stop-opacity="0"/></linearGradient>
          <linearGradient id="lgGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e6b73e"/><stop offset="1" stop-color="#a07820"/></linearGradient>
          <linearGradient id="lgBld" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2f8f60"/><stop offset="1" stop-color="#15573a"/></linearGradient>
        </defs>
        <circle cx="200" cy="140" r="120" fill="url(#lgSky)"/>
        <circle cx="200" cy="140" r="96" fill="none" stroke="#c9941e" stroke-opacity=".25" stroke-dasharray="3 6"/>
        <rect x="40" y="168" width="64" height="92" rx="4" fill="url(#lgBld)" opacity=".75"/>
        <rect x="296" y="150" width="70" height="110" rx="4" fill="url(#lgBld)" opacity=".75"/>
        <rect x="128" y="150" width="14" height="110" rx="3" fill="#0d2518" stroke="#c9941e" stroke-width="2"/>
        <rect x="258" y="150" width="14" height="110" rx="3" fill="#0d2518" stroke="#c9941e" stroke-width="2"/>
        <rect x="120" y="140" width="160" height="16" rx="8" fill="url(#lgGold)"/>
        <path d="M200 52 L252 72 V118 C252 148 230 170 200 182 C170 170 148 148 148 118 V72 Z" fill="#0f2d1f" stroke="url(#lgGold)" stroke-width="4"/>
        <path d="M176 116 L194 134 L228 96" fill="none" stroke="#e6b73e" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div class="login-art-title">تحكم كامل في الدخول والخروج</div>
      <div class="login-art-sub">من طلب التصريح حتى الاستعلام على البوابة — في نظام واحد.</div>
      <ul class="login-feats">
        <li><span>📝</span> طلبات تصاريح للأفراد والمركبات والخروج</li>
        <li><span>✅</span> مسار اعتماد واضح وصلاحيات حسب الدور</li>
        <li><span>🚪</span> بوابات بأكثر من جهاز واستعلام فوري</li>
        <li><span>📜</span> سجل كامل لكل عملية في النظام</li>
      </ul>
    </aside>
    <div class="login-main">
      <div class="login-security-badge">اتصال آمن</div>
      <div class="login-header">
        <div class="login-logo no-logo" id="loginLogo">🛡️</div>
        <div class="login-title" id="loginTitle">نظام تصاريح الدخول</div>
        <div class="login-title-sub">بوابة الوصول الآمن للمجمع</div>
      </div>
      <div class="login-body">
        @if (!string.IsNullOrEmpty(error))
        {
          <div class="login-error" style="display:block">@error</div>
        }
        <form asp-action="Login" asp-controller="Account" method="post" autocomplete="on">
          @Html.AntiForgeryToken()
          <div class="login-input-group">
            <label>👤 اسم المستخدم</label>
            <div class="login-input-wrap">
              <input type="text" name="username" placeholder="أدخل اسم المستخدم" autocomplete="username" autofocus>
              <span class="login-input-icon">👤</span>
            </div>
          </div>
          <div class="login-input-group">
            <label>🔐 كلمة المرور</label>
            <div class="login-input-wrap">
              <input type="password" name="password" placeholder="أدخل كلمة المرور" autocomplete="current-password">
              <span class="login-input-icon">🔒</span>
              <button type="button" class="login-password-toggle" style="position:absolute;left:12px;background:none;border:none;cursor:pointer;color:#94a3b8;font-size:15px;padding:6px;" onclick="togglePassword(this)">👁️</button>
            </div>
          </div>
          <button type="submit" class="login-btn">🔓 تسجيل الدخول</button>
        </form>
      </div>
      <div class="login-footer">© 2026 <b>نظام تصاريح الدخول</b> — الإصدار 1.0</div>
    </div>
  </div>
</div>
<script>
  function togglePassword(btn){
    const inp = btn.parentElement.querySelector('input');
    inp.type = inp.type === 'password' ? 'text' : 'password';
  }
</script>
</body>
</html>